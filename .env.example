# Copy to .env (local) or set these in your host's dashboard (Netlify/Vercel).
# NEVER commit real keys. .env is gitignored.

# Stripe — required only if checkoutMode = "stripe_session".
# Paste your Stripe SECRET key (test mode starts with "sk_test_", live with "sk_live_").
STRIPE_SECRET_KEY=

# Optional: a pre-made Stripe Price ID (starts with "price_") instead of the inline $27.
STRIPE_PRICE_ID=

# Optional: your canonical site URL (used for success/cancel redirects).
SITE_URL=https://the3dollarcandle.com

# Optional: Stripe webhook signing secret (starts with "whsec_") if you add fulfillment webhooks.
STRIPE_WEBHOOK_SECRET=
